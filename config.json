  "safety": {
    "_doc": "Photosensitivity guard. maxFlash caps every full-screen flash. preroll = seconds of silent warning page BEFORE the song (v4): the film starts at song time -preroll; every time in the code is song time (audio start = 0), so no cue moves. flashRange = the stretch the warning names, in SONG seconds; whatever is shown to viewers (the warning page, README, storyboard) adds preroll to it. warningLine = the Chinese line of the warning page (its characters must also be in fonts.cjk -> tcSans -> text, or they are not loaded). The dedicated preroll page is the only opening warning; there is no toast over the boot scene. tools/check_flash.py measures an exported file (use a 60 fps export).",
    "maxFlash": 0.7,
    "preroll": 5.0,
    "flashRange": [
      148.04,
      192.34
    ],
    "warningLine": "本片含有閃爍畫面與強光，光敏感者請留意"
  },
