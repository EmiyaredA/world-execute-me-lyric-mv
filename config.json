  "glow": {
    "_doc": "Matte interface, local glow. Bloom strength = (base + low * lowGain + flash * flashGain) * palette.glow, and only SATURATED pixels feed it: between satKnee[0] and satKnee[1] saturation a pixel goes from no bloom to full bloom, so cream / grey UI stays flat while orange and red accents glow.",
    "base": 0.55,
    "lowGain": 0.2,
    "flashGain": 0.8,
    "threshold": 0.0,
    "satKnee": [
      0.28,
      0.62
