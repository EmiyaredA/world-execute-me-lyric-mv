{
  "name": "world-execute-me-lyric-mv",
  "version": "5.0.0",
  "description": "Amadeus / Makise Kurisu red screenprint lyric MV for Mili - world.execute(me);",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lyrics": "node tools/fill_lyrics.mjs",
    "lyrics:retime": "node tools/python.mjs tools/parse_lrc.py && node tools/fill_lyrics.mjs --table",
    "check:lyrics": "node tools/check_no_lyrics.mjs",
    "analyze": "node tools/python.mjs tools/analyze_audio.py",
    "preview": "node export/server.mjs --open",
    "export:sample": "node export/export.mjs --start 0 --end 41 --width 960 --height 540 --fps 30 --out out/sample_0-41_540p30.mp4",
    "export:preview": "node export/export.mjs --width 1920 --height 1080 --fps 60 --out out/amadeus_1080p60.mp4",
    "export:4k": "node export/export.mjs --width 3840 --height 2160 --fps 60 --out out/amadeus_4k60.mp4",
    "storyboard": "node tools/storyboard.mjs",
    "check": "node tools/python.mjs tools/check_flash.py out/amadeus_1080p60.mp4 && node tools/python.mjs tools/check_sync.py out/amadeus_1080p60.mp4",
    "preview:layout": "node export/server.mjs --layout-only --open",
    "cover": "node export/export.mjs --lab cover --sheet out/amadeus_cover.png --times 0 --cols 1 --width 1920 --height 1080",
    "cover:portrait": "node export/export.mjs --lab coverPortrait --sheet out/amadeus_cover_portrait.png --times 0 --cols 1 --width 1080 --height 1920",
    "check:amadeus": "node tools/check_amadeus.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0"
  }
}
